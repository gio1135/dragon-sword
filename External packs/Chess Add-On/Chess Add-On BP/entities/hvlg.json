{
  "format_version": "1.21.70",
  "minecraft:entity": {
    "components": {
      "minecraft:damage_sensor": {
        "triggers": [
          { "cause": "all", "deals_damage": "no" },
          { "cause": "all", "deals_damage": "no" }
        ]
      },
      "minecraft:health": { "value": 10, "min": 1, "max": 10 },
      "minecraft:push_through": { "value": 1 },
      "minecraft:knockback_resistance": { "value": 1 },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:mob_effect_immunity": {
        "mob_effects": [
          "absorption",
          "bad_omen",
          "blindness",
          "conduit_power",
          "darkness",
          "fatal_poison",
          "fire_resistance",
          "haste",
          "health_boost",
          "hunger",
          "infested",
          "instant_damage",
          "instant_health",
          "invisibility",
          "jump_boost",
          "levitation",
          "mining_fatigue",
          "nausea",
          "night_vision",
          "oozing",
          "poison",
          "raid_omen",
          "regeneration",
          "resistance",
          "saturation",
          "slow_falling",
          "slowness",
          "speed",
          "strength",
          "trial_omen",
          "village_hero",
          "water_breathing",
          "weakness",
          "weaving",
          "wind_charged",
          "wither"
        ]
      },
      "minecraft:fire_immune": {},
      "minecraft:behavior.float": { "priority": 8 },
      "minecraft:physics": { "has_collision": false, "has_gravity": false },
      "minecraft:despawn": {
        "filters": {
          "any_of": [
            {
              "all_of": [
                { "test": "is_family", "operator": "!=", "value": "player" },
                { "test": "has_tag", "value": "instant_despawn" }
              ]
            }
          ]
        }
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:transient": {},
      "minecraft:rotation_axis_aligned": {},
      "minecraft:persistent": {},
      "minecraft:collision_box": { "width": 0, "height": 0 },
      "minecraft:type_family": {
        "family": [
          "ascent",
          "chess",
          "ascent_chess",
          "chessaddon",
          "ascent_chessaddon",
          "ascent_chess_board_blueprint"
        ]
      },
      "minecraft:breathable": {
        "breathes_solids": true,
        "breathes_water": true
      }
    },
    "description": {
      "is_summonable": true,
      "properties": {
        "ascent_chess:valid": {
          "type": "bool",
          "default": true,
          "client_sync": true
        },
        "ascent_chess:despawning": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      },
      "identifier": "ascent_chess:board_blueprint",
      "is_spawnable": false
    },
    "component_groups": {
      "ascent_chess:zdyh": { "minecraft:instant_despawn": {} },
      "ascent_chess:bhxk": {
        "minecraft:timer": {
          "time": 0.3,
          "time_down_event": { "event": "ascent_chess:zdyh" }
        }
      }
    },
    "events": {
      "ascent_chess:fbab": { "set_property": { "ascent_chess:valid": true } },
      "ascent_chess:bhxk": {
        "sequence": [
          { "add": { "component_groups": ["ascent_chess:bhxk"] } },
          { "set_property": { "ascent_chess:despawning": true } }
        ]
      },
      "ascent_chess:zdyh": {
        "sequence": [{ "add": { "component_groups": ["ascent_chess:zdyh"] } }]
      },
      "ascent_chess:zsqc": { "set_property": { "ascent_chess:valid": false } }
    }
  }
}
